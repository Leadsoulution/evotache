// Prisma schema — mirrors the shapes in src/types/*.ts exactly (same field
// names/types) so the service-layer rewrite (localStorage -> API routes) is
// mechanical. Scalar id-array fields (assigneeIds, teamIds, ...) use native
// Postgres arrays rather than join tables, matching today's data model.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  member
  member_limited
  viewer
}

enum UserStatus {
  active
  disabled
}

model User {
  id                  String     @id @default(cuid())
  name                String
  email               String     @unique
  passwordHash        String
  role                Role
  color               String
  photoDataUrl        String?
  status              UserStatus @default(active)
  managerIds          String[]   @default([])
  // string[] | null in the app — null means "no admin restriction, sees
  // everything". Prisma arrays can't be nullable, so this is stored as Json
  // (either a JSON array of strings, or JSON null) instead of String[]?.
  visibleSectionHrefs Json?
  hiddenColumnIds     String[]   @default([])
  // AI agent "employee" account — never logs in with a password, excluded
  // from assignee pickers, has an AgentConfig row with its persona/tools.
  isAgent             Boolean    @default(false)
  createdAt           DateTime   @default(now())

  pushSubscriptions PushSubscription[]
  agentConfig       AgentConfig?

  @@map("users")
}

model Team {
  id               String   @id @default(cuid())
  name             String
  color            String
  memberIds        String[] @default([])
  excludedUserIds  String[] @default([])
  createdAt        DateTime @default(now())

  @@map("teams")
}

model Project {
  id              String   @id @default(cuid())
  name            String
  description     String
  color           String
  logoDataUrl     String?
  teamIds         String[] @default([])
  excludedUserIds String[] @default([])
  createdAt       DateTime @default(now())

  tasks Task[]

  @@map("projects")
}

enum TaskModule {
  task
  dispute
}

model Task {
  id              String     @id @default(cuid())
  module          TaskModule
  title           String
  description     String     @default("")
  status          String
  priority        String
  assigneeIds     String[]   @default([])
  teamIds         String[]   @default([])
  excludedUserIds String[]   @default([])
  dueDate         DateTime?
  recurrence      Json?
  order           Float
  customValues    Json       @default("{}")
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  parentId String?
  parent   Task?   @relation("TaskParent", fields: [parentId], references: [id], onDelete: Cascade)
  children Task[]  @relation("TaskParent")

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@map("tasks")
}

enum CustomFieldType {
  text
  number
  date
  select
  image
  video
  link
}

model CustomFieldDef {
  id        String          @id @default(cuid())
  name      String
  type      CustomFieldType
  options   Json            @default("[]")
  order     Int
  createdAt DateTime        @default(now())

  @@map("custom_fields")
}

model StatusDef {
  id    String @id @default(cuid())
  label String
  color String
  order Int

  @@map("statuses")
}

model PriorityDef {
  id    String @id @default(cuid())
  label String
  color String
  order Int

  @@map("priorities")
}

enum PurchaseColumnType {
  text
  number
  dropdown
  image
  video
  link
  date
}

model PurchaseColumnDef {
  id        String             @id @default(cuid())
  name      String
  type      PurchaseColumnType
  options   Json               @default("[]")
  order     Int
  createdAt DateTime           @default(now())

  @@map("purchase_columns")
}

model PurchaseItem {
  id              String   @id @default(cuid())
  order           Float
  values          Json     @default("{}")
  assigneeIds     String[] @default([])
  excludedUserIds String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("purchase_items")
}

enum ConversationType {
  direct
  group
}

model Conversation {
  id                  String           @id @default(cuid())
  type                ConversationType
  name                String?
  participantIds      String[]         @default([])
  avatarDataUrl       String?
  createdBy           String
  createdAt           DateTime         @default(now())
  lastMessageAt       DateTime         @default(now())
  lastMessagePreview  String?
  lastReadAt          Json             @default("{}")

  messages Message[]

  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  text           String       @default("")
  attachments    Json         @default("[]")
  createdAt      DateTime     @default(now())

  @@map("messages")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@map("push_subscriptions")
}

enum AgentKind {
  internal
  external
}

model AgentConfig {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind             AgentKind
  systemPrompt     String
  // "tasks","litiges","achats","email","telegram","whatsapp","websearch","gmail","drive","n8n"
  enabledTools     String[]  @default([])
  telegramChatId   String?
  telegramLinkCode String?
  whatsappNumber   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("agent_configs")
}

model AgentSchedule {
  id              String    @id @default(cuid())
  agentId         String
  instructionText String
  cronExpression  String
  actionType      String
  actionConfig    Json      @default("{}")
  enabled         Boolean   @default(true)
  lastRunAt       DateTime?
  nextRunAt       DateTime?
  createdAt       DateTime  @default(now())

  @@map("agent_schedules")
}

model AgentActionLog {
  id        String   @id @default(cuid())
  agentId   String
  type      String
  summary   String
  payload   Json?
  success   Boolean
  error     String?
  createdAt DateTime @default(now())

  @@map("agent_action_logs")
}

model AgentIntegration {
  id          String    @id @default(cuid())
  agentId     String
  provider    String
  credentials Json
  status      String    @default("disconnected")
  connectedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([agentId, provider])
  @@map("agent_integrations")
}

model LibraryDoc {
  id        String   @id @default(cuid())
  title     String
  // Markdown — readable for humans (rendered) and directly usable as plain-text context for AI agents.
  content   String   @default("")
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("library_docs")
}
